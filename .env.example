DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI-compatible fallback. The agent route uses DeepSeek first,
# then OpenAI if DEEPSEEK_API_KEY is not set.
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional shared model override.
AGENT_MODEL=

# Resume request forwarding. Create a Formspree form and paste its endpoint here.
FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
